# Weights and reference checkouts. The engine downloads these; they are hundreds
# of gigabytes and reproducible from the pinned revisions in model-configs/.
models/
model/
gguf/
research/
checkpoints/
hf-cache/
kv-cache/

# Server state and logs: instance records, per-port metrics and logs
run/
server.pid
server.log
*.log
metrics.json
monitor.json
telemetry.json

# Measurement output. Every `check_*.py` writes its results next to itself, and
# they are regenerated by `k2mlx bench`; the numbers that matter are summarised in
# docs/decoding-and-memory.md and docs/operations.md. WORK_STATUS.json is the one
# root JSON that is state rather than output, so it stays.
/*.json
!/WORK_STATUS.json

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
